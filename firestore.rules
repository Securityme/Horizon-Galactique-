rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.get('displayName', '') is string
        && data.get('createdAt', '') is string
        && data.get('updatedAt', '') is string;
    }

    function isValidGameSave(data) {
      return data.keys().hasAll(['saveId', 'ownerId', 'contractVersion', 'seed', 'checkpointTurn', 'checkpoint'])
        && data.saveId is string && data.saveId.size() <= 128
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.contractVersion is string && data.contractVersion.size() <= 32
        && data.seed is number
        && data.checkpointTurn is number
        && data.get('gameVersion', '') is string
        && data.get('createdAt', '') is string
        && data.get('updatedAt', '') is string;
    }

    function isValidUserSettings(data) {
      return data.keys().hasAll(['theme', 'volume', 'language'])
        && data.theme is string && data.theme.size() <= 64
        && data.volume is number
        && data.language is string && data.language.size() <= 16
        && data.get('ambientDrone', false) is bool
        && data.get('updatedAt', '') is string;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == request.auth.uid;
      allow delete: if isOwner(userId);

      match /saves/{saveId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(saveId) && isValidGameSave(incoming()) && incoming().ownerId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(saveId) && isValidGameSave(incoming()) && incoming().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
        allow delete: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(settingId) && isValidUserSettings(incoming());
        allow update: if isOwner(userId) && isValidId(settingId) && isValidUserSettings(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
